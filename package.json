{
  "name": "oingg-gov-ts",
  "version": "1.0.0",
  "description": "Ingests data from the Central Bank of the Republic of China (Taiwan) Statistical Database API into a Postgres database.",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && tsc-alias",
    "postinstall": "prisma generate",
    "scheduler:check": "tsx scripts/reconcileScheduler.ts",
    "scheduler:apply": "tsx scripts/reconcileScheduler.ts --apply",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "ultimate-express": "^2.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
