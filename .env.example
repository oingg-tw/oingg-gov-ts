# runtime 用（host 帶 -pooler）
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=verify-full&pgbouncer=true"

# migration 用（不帶 -pooler）
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

PORT=8084

# 保護 /api/ingest/* 端點，避免任意人觸發抓取。本機開發用任意字串即可。
TASK_SECRET="本機開發用的密鑰"
